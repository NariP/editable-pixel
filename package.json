{
  "name": "editable-pixel-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @editable-pixel/web dev",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "sync-version": "node scripts/sync-version.mjs",
    "test:distribution": "node tests/distribution/package-install.mjs",
    "test:source-install": "node tests/distribution/source-install.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
