{
  "name": "editable-pixel",
  "version": "1.0.1",
  "description": "Local-first pixel workbench with a browser editor, CLI, MCP server, and Codex/Claude skill.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NariP/editable-pixel.git"
  },
  "homepage": "https://github.com/NariP/editable-pixel#readme",
  "bugs": {
    "url": "https://github.com/NariP/editable-pixel/issues"
  },
  "keywords": ["pixel-art", "sprite", "mcp", "codex", "claude", "local-first"],
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "editable-pixel": "./dist/cli.js",
    "editable-pixel-server": "./dist/server-runner.js",
    "editable-pixel-mcp": "./dist/mcp.js"
  },
  "main": "./dist/cli.js",
  "files": ["dist", "web", "skills", "docs", "install.sh", "README.md", "README.ko.md", "CONTRIBUTING.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/prepare-package.mjs",
    "prepack": "pnpm build",
    "postpack": "node scripts/prepare-package.mjs --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "busboy": "1.6.0",
    "commander": "15.0.0",
    "open": "11.0.1",
    "sharp": "0.35.3",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@editable-pixel/converter": "workspace:*",
    "@editable-pixel/core": "workspace:*",
    "@editable-pixel/document": "workspace:*",
    "@editable-pixel/mcp": "workspace:*",
    "@editable-pixel/project": "workspace:*",
    "@editable-pixel/renderer": "workspace:*",
    "@editable-pixel/server": "workspace:*",
    "tsup": "8.5.1"
  }
}
